# Copy to .env.local for `vercel dev`. NEVER commit real values.
# In production set these in Vercel > Project > Settings > Environment Variables.

# --- Gemini (chat, aptitude generator, Hiring Hub ATS) ---
GEMINI_API_KEY=your_gemini_api_key      # LLM_API_KEY works too
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Adzuna (India tab of the Hiring Hub; free keys at developer.adzuna.com) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Abuse protection (api/_lib/guard.js) ---
# Strongly recommended in production. Free Redis at upstash.com. Without these,
# rate limits fall back to per-instance memory, which is weak on serverless.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Extra origins allowed to call /api (comma-separated). Same-origin is always allowed.
# ALLOWED_ORIGINS=https://your-custom-domain.com
